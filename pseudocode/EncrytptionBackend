// User logs in
fn login(username: &str, password: &str) {
    // Derive or decrypt the user's private key from their password or secure storage
    let private_key = decrypt_private_key(password);

    // Request encrypted workspace AES keys from server
    let encrypted_aes_keys = server_api.get_encrypted_aes_keys(username);

    // Decrypt all AES keys with the user's private key
    let mut aes_keys = Vec::new();
    for encrypted_key in encrypted_aes_keys {
        let aes_key = decrypt_with_private_key(&encrypted_key, &private_key);
        aes_keys.push(aes_key);
    }

    // Store decrypted AES keys locally for use in decrypting workspace notes
    store_keys_locally(aes_keys);
}

// User creates a new workspace
fn create_workspace() {
    // Generate a new AES key for the workspace (used for symmetric encryption of notes)
    let aes_key = generate_random_aes_key();

    // Encrypt the AES key with the user's own public key
    let public_key = get_own_public_key();
    let encrypted_aes_key = encrypt_with_public_key(&aes_key, &public_key);

    // Send workspace data and encrypted AES key to the server
    server_api.create_workspace(encrypted_aes_key);
}

// Decrypt note when displaying to user
fn view_note(encrypted_note: &str, workspace_id: u64) -> String {
    // Load the AES key for this workspace
    let aes_key = load_aes_key_for_workspace(workspace_id);

    // Decrypt the note using AES
    decrypt_with_aes(encrypted_note, aes_key)
}
